{
  "name": "hr-enbek-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "mock:cms": "node tooling/mock-cms/server.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings=0",
    "lint:fsd": "steiger ./src",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "spell": "cspell --no-progress --gitignore \"**/*.{ts,tsx,json,md,css}\"",
    "unused": "knip",
    "duplicates": "jscpd src app",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "test:e2e": "playwright test --project=desktop-chromium --project=mobile-chromium",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "design:compare": "node tooling/scripts/compare-design.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "size": "size-limit",
    "lighthouse": "lhci autorun",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:css && pnpm lint:fsd && pnpm format:check && pnpm spell && pnpm i18n:check && pnpm unused && pnpm duplicates && pnpm test && pnpm licenses:check",
    "check:commit": "pnpm typecheck:tsc && pnpm lint:fsd && pnpm unused && pnpm duplicates && pnpm i18n:check",
    "check:push": "pnpm lint && pnpm lint:css && pnpm format:check && pnpm spell && pnpm test && pnpm licenses:check",
    "check:ci": "pnpm check && pnpm build && pnpm size && pnpm test:e2e",
    "prepare": "husky",
    "i18n:check": "node tooling/scripts/check-messages.ts",
    "licenses:check": "node tooling/scripts/check-licenses.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/montserrat-alternates": "5.3.0",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.104.1",
    "lucide-react": "1.51.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@cspell/dict-ru_ru": "2.3.2",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint-react/eslint-plugin": "5.23.5",
    "@eslint/js": "9.39.5",
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@lhci/cli": "0.15.1",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "14.1.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/nextjs-vite": "10.6.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.104.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cspell": "10.3.6",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-no-secrets": "2.3.3",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-storybook": "10.6.1",
    "eslint-plugin-unicorn": "65.0.1",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "jscpd": "5.4.0",
    "jsdom": "30.1.1",
    "knip": "6.39.0",
    "lint-staged": "17.6.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "size-limit": "14.1.0",
    "steiger": "0.7.0",
    "storybook": "10.6.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
